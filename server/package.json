{
  "name": "overview-teams-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/ensure-local-ai.js",
    "prestart": "node --env-file-if-exists=.env scripts/ensure-local-ai.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "test:db:setup": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
